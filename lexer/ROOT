chapter AFP

session Token in "token" = HOL +
  description "Spans, positions, and the token record standalone"
  options [timeout = 300]
  theories Token
  document_files "root.tex"

session Lexer = Token +
  description
    "Symbolic regexes and their derivatives, the inductive lexer
     specification, the DFA table generator and the runner."
  options [timeout = 600]
  sessions "Regular-Sets" "HOL-Library"
  theories Regex Pred_Algebra Intervals Spec Gen Lexer Driver Tables Codepoints
  document_files "root.tex" "root.bib"

session Lexer_Command in "command" = Lexer +
  description "The pattern sublanguage and the lexer command."
  options [document = false, timeout = 300]
  theories Pattern Rules Lexer_Command
  document_files (in "../document") "root.bib"

session Lexer_Tests in "tests" = Lexer_Command +
  description "Tests and examples."
  options [document = false, timeout = 600]
  sessions "CaraML_Lexer"
  theories Intervals_Tests Tables_Tests Driver_Tests Codepoint_Tests Pattern_Tests
    Lexer_Command_Tests Lexer_Table_Tests CaraML_Lexer_Tests
  document_files (in "../document") "root.bib"

session CaraML_Lexer in "caraml" = Lexer_Command +
  description "WIP for CaraML."
  options [document = false, timeout = 600]
  theories CaraML_Spec CaraML_Lexer
  document_files (in "../document") "root.bib"
